# Gemini (optional). Rules + retrieval build every plan; Gemini refines cache misses.
# Put the real values in .env (git- and docker-ignored) or your host's environment. Never commit a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_TIMEOUT_S=4
GEMINI_STAGES=understand,rerank,describe,variations
# USD per 1M tokens for cost reporting (0 on the AI Studio free tier)
GEMINI_PRICE_IN_PER_M=0
GEMINI_PRICE_OUT_PER_M=0
PORT=8000
